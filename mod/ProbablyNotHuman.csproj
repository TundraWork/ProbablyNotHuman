<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <AssemblyName>ProbablyNotHuman</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(ManagedDir)\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Set GameDir to the installed Probably Stolen folder." />
  </Target>
</Project>
